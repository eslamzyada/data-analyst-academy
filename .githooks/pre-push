#!/bin/sh
# Refuses any push that would change main (including deleting it or force-pushing it).
# main changes only through a pull request that the owner reviews and merges on GitHub.
# Enable once per clone:  git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing to push to main. Push a feature branch and open a pull request instead." >&2
    exit 1
  fi
done
exit 0
